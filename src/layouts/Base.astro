---
// Visual system: "Structure proof" (GPT design proposal, 2026-10-25) — tokens, type scale and
// components ported from public/design-proposal/mockups.html, plus two site-wide toggles of my own:
// [parse] shows every block's bounding box + type label (what a layout parser sees),
// [font] swaps the Japanese body face (the T3 question: same text, different font).
import { LANGS, href, t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  /** Current path without locale prefix, e.g. "/research". */
  path: string;
}
const { title, description = '', path } = Astro.props;
const lang = (Astro.currentLocale ?? 'ja') as Lang;
const d = t(lang);
const htmlLang = lang === 'zh' ? 'zh-CN' : lang;
const nav = [
  { key: 'works', to: '/works' },
  { key: 'research', to: '/research' },
  { key: 'notes', to: '/notes' },
] as const;
const langShort: Record<Lang, string> = { ja: 'JA', zh: 'ZH', en: 'EN' };
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {d.siteName}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@400;600&family=BIZ+UDGothic&display=swap" rel="stylesheet" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={href(l, path)} />)}
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="logo" viewBox="0 0 16 16">
        <path d="M1 5V1h4M11 15h4v-4" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M4 5h8" fill="none" stroke="var(--accent)" stroke-width="2" />
        <path d="M4 9h5M4 12h7" fill="none" stroke="currentColor" stroke-width="2" />
      </symbol>
    </svg>
    <a class="skip" href="#main">skip</a>
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href={href(lang, '/')}>
          <svg class="mark" aria-hidden="true"><use href="#logo" /></svg>
          <span>{d.siteName}</span>
        </a>
        <nav class="site-nav" aria-label="main">
          {nav.map((n) => (
            <a href={href(lang, n.to)} aria-current={path.startsWith(n.to) ? 'page' : undefined}>{d.nav[n.key]}</a>
          ))}
          <span class="languages" aria-label="language">
            {LANGS.map((l, i) => (
              <>
                {i > 0 && ' / '}
                {l === lang ? <strong>{langShort[l]}</strong> : <a href={href(l, path)} lang={l}>{langShort[l]}</a>}
              </>
            ))}
          </span>
          <span class="toggles" aria-label="view">
            <button type="button" class="tgl" data-toggle="parse" aria-pressed="false" title={d.toggles.parseHelp}>[{d.toggles.parse}]</button>
            <button type="button" class="tgl" data-toggle="font" aria-pressed="false" title={d.toggles.fontHelp}>[{d.toggles.font}]</button>
            <select id="theme" aria-label={d.toggles.theme}>
              <option value="system">{d.toggles.system}</option>
              <option value="light">{d.toggles.light}</option>
              <option value="dark">{d.toggles.dark}</option>
            </select>
          </span>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>{d.footer.line}</p>
        <p class="mono">JA / ZH / EN · {d.footer.note}</p>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const theme = document.getElementById('theme') as HTMLSelectElement | null;
      theme?.addEventListener('change', () => {
        if (theme.value === 'system') root.removeAttribute('data-theme');
        else root.dataset.theme = theme.value;
      });
      // [parse] and [font]: body attributes, pure CSS does the rest.
      document.querySelectorAll<HTMLButtonElement>('.tgl').forEach((b) => {
        b.addEventListener('click', () => {
          const key = b.dataset.toggle!;
          const on = document.body.getAttribute('data-' + key) !== null;
          if (key === 'font') {
            const seq = [null, 'serif', 'ud'];
            const cur = document.body.getAttribute('data-font');
            const next = seq[(seq.indexOf(cur) + 1) % seq.length];
            if (next) document.body.setAttribute('data-font', next); else document.body.removeAttribute('data-font');
            b.setAttribute('aria-pressed', String(Boolean(next)));
            b.textContent = next ? `[${b.dataset.label}: ${next}]` : `[${b.dataset.label}]`;
            return;
          }
          if (on) document.body.removeAttribute('data-' + key); else document.body.setAttribute('data-' + key, '');
          b.setAttribute('aria-pressed', String(!on));
        });
        b.dataset.label = b.textContent!.replace(/^\[|\]$/g, '');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #faf9f5; --surface: #f0efe9; --text: #141413; --muted: #595951;
    --accent: #2166b5; --line: #d8d8ce; --line-strong: #66685e;
    --sans: Inter, 'Noto Sans JP', sans-serif; --mono: 'IBM Plex Mono', monospace;
    --step-0: 1rem; --step-1: 1.125rem; --step-2: 1.5rem; --step-3: 2rem;
    --display: clamp(2rem, 4.2vw, 3rem);
    /* ordinal status ramp (validated) */
    --st-1: #86b6ef; --st-1-fg: #0b0b0b; --st-2: #3987e5; --st-2-fg: #fff; --st-3: #1c5cab; --st-3-fg: #fff; --st-4: #0d366b; --st-4-fg: #fff;
    /* lineage map: theme bands + edge types (from the prototype) */
    --t01: #2166b5; --t02: #277e76; --t03: #a47729; --t04: #b15b4e;
    --edge-extends: var(--accent); --edge-addresses: #258679; --edge-contrasts: #bb6844;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark; --bg: #171816; --surface: #20221f; --text: #f0efe7; --muted: #b7bbb0;
      --accent: #8abaff; --line: #3d4139; --line-strong: #858b7d;
      --st-1: #9ec5f4; --st-1-fg: #0b0b0b; --st-2: #6da7ec; --st-2-fg: #0b0b0b; --st-3: #3987e5; --st-3-fg: #fff; --st-4: #1c5cab; --st-4-fg: #fff;
      --t01: #8abaff; --t02: #75beb0; --t03: #d1ac66; --t04: #e19b8b; --edge-addresses: #75beb0; --edge-contrasts: #e19b8b;
    }
  }
  :root[data-theme='dark'] {
    color-scheme: dark; --bg: #171816; --surface: #20221f; --text: #f0efe7; --muted: #b7bbb0;
    --accent: #8abaff; --line: #3d4139; --line-strong: #858b7d;
    --st-1: #9ec5f4; --st-1-fg: #0b0b0b; --st-2: #6da7ec; --st-2-fg: #0b0b0b; --st-3: #3987e5; --st-3-fg: #fff; --st-4: #1c5cab; --st-4-fg: #fff;
    --t01: #8abaff; --t02: #75beb0; --t03: #d1ac66; --t04: #e19b8b; --edge-addresses: #75beb0; --edge-contrasts: #e19b8b;
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: 2rem; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 1rem/1.9 var(--sans); word-break: normal; overflow-wrap: anywhere; line-break: strict; letter-spacing: 0; }
  :lang(zh-CN) { font-family: Inter, 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif; line-height: 1.85; }
  :lang(en) { line-height: 1.65; }
  body[data-font='serif'] { --sans: 'Noto Serif JP', Georgia, serif; }
  body[data-font='ud'] { --sans: 'BIZ UDGothic', 'Noto Sans JP', sans-serif; }
  h1, h2, h3, h4, p, figure, ol, ul, dl { margin: 0; }
  h1, h2, h3 { font-weight: 600; line-height: 1.55; letter-spacing: 0; text-wrap: pretty; }
  h2 { font-size: var(--step-3); } h3 { font-size: var(--step-2); }
  p + p { margin-top: 1em; }
  a { color: var(--accent); text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  button, select { font: inherit; color: inherit; }
  button, select { min-height: 36px; border: 1px solid var(--line-strong); border-radius: 0; background: var(--bg); padding: 0.2rem 0.6rem; }
  button { cursor: pointer; } button:hover { border-color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  ::selection { background: var(--accent); color: var(--bg); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .skip { position: fixed; top: 0; left: 1rem; z-index: 9; background: var(--bg); padding: 0.75rem; transform: translateY(-150%); }
  .skip:focus { transform: none; }
  .mono, .eyebrow, .meta, .figure-number { font: 400 0.875rem/1.65 var(--mono); }
  .eyebrow, .meta { color: var(--muted); } .eyebrow { letter-spacing: 0.035em; }
  .accent { color: var(--accent); } .muted { color: var(--muted); } .note { font-size: 0.875rem; color: var(--muted); }
  .wrap { max-width: 1136px; margin-inline: auto; padding-inline: 32px; }
  .reading { max-width: 42rem; }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 24px; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; font-size: 1rem; font-weight: 600; }
  .mark { width: 28px; height: 28px; flex: none; }
  .site-nav { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; font-size: 0.875rem; }
  .site-nav > a { color: var(--text); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .site-nav > a[aria-current] { color: var(--accent); text-decoration: underline; text-underline-offset: 0.5em; }
  .languages { font: 400 0.875rem/1.6 var(--mono); white-space: nowrap; color: var(--muted); }
  .languages strong { color: var(--text); font-weight: 500; } .languages a { color: var(--muted); text-decoration: none; }
  .toggles { display: inline-flex; gap: 8px; align-items: center; }
  .tgl { font: 400 0.8rem/1 var(--mono); border: 0; background: none; color: var(--muted); padding: 0.3rem 0.2rem; min-height: 0; }
  .tgl[aria-pressed='true'] { color: var(--accent); }
  #theme { font: 400 0.8rem/1 var(--mono); padding: 0.3rem 0.4rem; min-height: 0; border-color: var(--line); }
  main { padding-bottom: 56px; }
  .page-lead { padding: 62px 0 42px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; }
  .page-lead h1 { font-size: var(--display); margin-top: 12px; line-height: 1.45; letter-spacing: -0.025em; }
  .page-lead p { max-width: 35em; }
  .section-heading { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; padding-block: 24px; border-top: 1px solid var(--line-strong); }
  .section-heading h2 { font-size: 1.5rem; } .section-heading h2 .mono { margin-right: 18px; color: var(--accent); }
  .state { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; }
  .state::before { content: ''; width: 7px; height: 7px; border: 1.5px solid var(--accent); flex: none; }
  .st { display: inline-flex; align-items: center; gap: 6px; font: 500 0.78rem/1.6 var(--mono); padding: 0 8px; border: 1px solid var(--line-strong); }
  .st::before { content: ''; width: 8px; height: 8px; border-radius: 50%; }
  .st-1::before { background: var(--st-1); } .st-2::before { background: var(--st-2); } .st-3::before { background: var(--st-3); } .st-4::before { background: var(--st-4); }
  details { margin-top: 20px; border-top: 1px solid var(--line-strong); }
  summary { padding: 12px 0; cursor: pointer; min-height: 44px; color: var(--accent); font-weight: 500; }
  details[open] summary { margin-bottom: 8px; }
  blockquote { margin: 0; padding: 16px 20px; background: var(--surface); font-size: 0.875rem; }
  blockquote cite { display: block; margin-top: 12px; font-style: normal; color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { text-align: left; padding: 8px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-family: var(--mono); font-size: 0.8rem; }
  .site-footer { display: flex; justify-content: space-between; gap: 24px; align-items: flex-end; border-top: 1px solid var(--line); padding: 22px 0 40px; color: var(--muted); font-size: 0.875rem; }
  /* [parse]: what a layout parser sees */
  body[data-parse] main :is(h1, h2, h3, p, table, figure, blockquote, ol, ul, dl) { outline: 1px dashed var(--line-strong); outline-offset: 3px; position: relative; }
  body[data-parse] main :is(h1, h2, h3, p, table, figure, blockquote, ol, ul, dl)::before { position: absolute; top: -1.05em; left: 0; font: 500 10px/1 var(--mono); color: var(--accent); background: var(--bg); padding: 0 3px; letter-spacing: 0.04em; }
  body[data-parse] main h1::before { content: 'doc_title'; }
  body[data-parse] main :is(h2, h3)::before { content: 'paragraph_title'; }
  body[data-parse] main p::before { content: 'text'; }
  body[data-parse] main table::before { content: 'table'; }
  body[data-parse] main figure::before { content: 'figure'; }
  body[data-parse] main blockquote::before { content: 'quote'; }
  body[data-parse] main :is(ol, ul, dl)::before { content: 'list'; }
  @media (max-width: 900px) {
    .site-header { align-items: flex-start; flex-wrap: wrap; } .site-nav { gap: 18px; }
    .page-lead { grid-template-columns: 1fr; gap: 24px; padding: 44px 0 32px; }
  }
  @media (max-width: 650px) {
    .wrap { padding-inline: 20px; } .site-header { gap: 12px; padding-block: 20px; }
    .site-nav { width: 100%; gap: 14px; justify-content: space-between; }
    .page-lead h1 { font-size: 2rem; } .site-footer { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
